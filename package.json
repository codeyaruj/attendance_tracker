{
  "name": "attendsafe",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0 <23",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "prepare:ocr-assets": "node scripts/copy-local-ocr-assets.mjs",
    "predev": "node scripts/copy-local-ocr-assets.mjs",
    "dev": "next dev",
    "dev:mobile": "next dev --hostname 0.0.0.0",
    "prebuild": "node scripts/copy-local-ocr-assets.mjs",
    "build": "next build",
    "start": "node scripts/serve-static.mjs out 3000",
    "serve:static": "node scripts/serve-static.mjs out 4173",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium --project=mobile-chromium",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:mobile": "playwright test --project=mobile-chromium",
    "test:e2e:responsive": "playwright test --grep @responsive --project=mobile-320 --project=mobile-375 --project=mobile-390 --project=mobile-412 --project=tablet",
    "test:e2e:cross-browser": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:accessibility": "playwright test --project=chromium --grep @accessibility",
    "test:installation": "playwright test --grep @installation --project=mobile-chromium --project=mobile-webkit",
    "test:pwa": "node scripts/copy-local-ocr-assets.mjs && NEXT_PUBLIC_SITE_URL=https://attendance.example.pages.dev next build && playwright test --config=playwright.pwa.config.ts",
    "verify:static": "node scripts/verify-static-output.mjs",
    "verify:security": "node scripts/security-regression-check.mjs",
    "verify:build-policy": "node scripts/verify-pnpm-build-policy.mjs",
    "verify:assets": "node scripts/verify-asset-sizes.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs --history",
    "verify": "node scripts/run-verification.mjs verify",
    "verify:release": "node scripts/run-verification.mjs release",
    "ci": "node scripts/run-verification.mjs verify",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "5.4.0",
    "@tesseract.js-data/eng": "1.0.0",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "dexie": "4.4.4",
    "dexie-react-hooks": "4.4.0",
    "lucide-react": "1.25.0",
    "next": "16.2.11",
    "pdfjs-dist": "6.1.200",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "7.82.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tesseract.js": "7.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "fake-indexeddb": "6.2.5",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sharp": "0.35.3",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "vitest": "4.1.10"
  },
  "type": "module"
}
