{
  "name": "attendsafe",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prepare:ocr-assets": "node scripts/copy-local-ocr-assets.mjs",
    "predev": "pnpm prepare:ocr-assets",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "prebuild": "pnpm prepare:ocr-assets",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "5.4.0",
    "@tesseract.js-data/eng": "1.0.0",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "dexie": "4.4.4",
    "dexie-react-hooks": "4.4.0",
    "lucide-react": "1.25.0",
    "next": "16.2.6",
    "pdfjs-dist": "6.1.200",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "7.82.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tesseract.js": "7.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "fake-indexeddb": "6.2.5",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "react-server-dom-webpack": "19.2.6",
    "sharp": "0.35.3",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vitest": "4.1.10",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "tesseract.js"
    ]
  }
}
